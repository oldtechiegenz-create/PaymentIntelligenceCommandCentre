# Copy to .env and fill in real values. Never commit .env itself.
DB_PATH=./app/db/payment_command_center.db

# --- Kuber AI agents ---
# Provider: ollama (default, local) | anthropic | vertex_proxy | openai_proxy | db_ai_access_layer
LLM_PROVIDER=anthropic
# Create a key at https://console.anthropic.com/settings/keys (API billing is separate from a Claude.ai subscription)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
